{
  "name": "signalboard",
  "version": "0.1.0",
  "description": "本地桌面端项目概况板",
  "productName": "SignalBoard",
  "main": "src/main/index.js",
  "bin": {
    "signalboard-mcp": "bin/signalboard-mcp.js"
  },
  "scripts": {
    "start": "electron .",
    "test:scan": "node scripts/test-scan.js",
    "test:ai": "node scripts/test-ai.js",
    "test:github": "node scripts/test-github.js",
    "test:handoffs": "node scripts/test-handoffs.js",
    "test:intent": "node scripts/test-intent.js",
    "test:mcp": "node scripts/test-mcp.js",
    "test:renderer": "node scripts/test-renderer.js",
    "theme:sync": "node scripts/sync-theme-root.js",
    "audit:site": "node scripts/audit-site.js",
    "shot": "electron scripts/screenshot.js",
    "demo": "electron scripts/screenshot.js --gif",
    "logo": "electron scripts/render-logo.js",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "build": {
    "appId": "com.yaemikoreal.signalboard",
    "productName": "SignalBoard",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SignalBoard"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.4"
  }
}
